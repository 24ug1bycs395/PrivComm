# =============================================================================
# Cyber Sentinel Environment & API Configuration
# =============================================================================

# Optional: Google Gemini LLM API Key
# Used to generate dynamic AI explanations for rare, legacy, or unhandled edge-case ciphers/protocols.
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred Gemini Model Version (Default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Server Host & Port Settings
HOST=0.0.0.0
PORT=8000
# Copy to .env and fill in values. Docker Compose loads these into the container.

# Optional — used when cloud persistence is enabled
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cryptographic policy baseline inside the container
SECURITY_POLICY_PATH=/app/config/security_policy.yaml

# Override only if tshark is installed somewhere other than /usr/bin/tshark
TSHARK_PATH=/usr/bin/tshark
