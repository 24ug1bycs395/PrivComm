# =============================================================================
# PrivComm — AI-Assisted IPsec VPN Security Intelligence Platform
# Environment & API Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# 1. AI & LLM Assistant Settings (Google Gemini API)
# -----------------------------------------------------------------------------
# Optional: Google Gemini API Key for AI Assistant chatbot & explanation engine
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred Gemini Model Version (Default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------------------
# 2. Server Host & Port Settings
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------------------
# 3. Database & Cloud Persistence (Supabase Cloud Storage)
# -----------------------------------------------------------------------------
# Optional — leave empty to operate in local JSON / file storage fallback mode
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# 4. Engine & Security Policy Paths
# -----------------------------------------------------------------------------
# Cryptographic policy baseline file path
SECURITY_POLICY_PATH=config/security_policy.yaml

# TShark executable path override (Default: /usr/bin/tshark on Linux or C:\Program Files\Wireshark\tshark.exe on Windows)
TSHARK_PATH=/usr/bin/tshark
