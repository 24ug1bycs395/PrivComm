# =============================================================================
# Privcomm — .gitignore
# AI-Assisted IPsec VPN Security Intelligence Platform
# =============================================================================

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Virtual Environments
.venv/
venv/
env/
.env/
ENV/

# Distribution / Packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
MANIFEST

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / Coverage
.tox/
.coverage
.coverage.*
coverage.xml
*.cover
.pytest_cache/
htmlcov/
nosetests.xml
.hypothesis/

# mypy / type checking
.mypy_cache/
.dmypy.json
dmypy.json

# Pyright
pyrightconfig.json

# ─── Environment & Secrets ───────────────────────────────────────────────────
.env
.env.*
*.local
!*.env.example

# Never commit raw packet captures — except sample reference capture
*.pcap
*.pcapng
*.cap
*.dmp
!samples/ikev2_s2s_ipsec_vpn_aes_gcm.pcapng

# Upload staging directories & generated results
uploads/
upload_temp/
results/*.json
results/*.html
results/*.csv

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── OS Generated ────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ─── IDE / Editor ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.iml
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~

# ─── Node / Frontend (if applicable later) ───────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js

# ─── Reports & Generated Outputs ─────────────────────────────────────────────
# Note: Keep Python reporting package tracked, ignore generated report outputs
!reports/*.py
exports/
*.pdf
*.json.bak
!frontend/public/reports/**
!frontend/public/samples/**

# ─── Temporary Files ─────────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.swp

# ─── Large ML Benchmark Models (>100MB — use Git LFS or host externally) ─────
# random_forest_model.joblib is 329MB and exceeds GitHub's 100MB limit.
# XGBoost and other smaller models are fine to commit normally.
models/random_forest_model.joblib

# ─── Demonstration Scripts & Local Test Verification ────────────────────────
docs/DEMONSTRATION_VIDEO.md
docs/DEMO_VIDEO_FULL_SCRIPT.md
tests/verify_all_requirements.py